# StockPilot Backend Configuration Example
# Copy this file to .env for local development

# Server Configuration
PORT=8080
ENV=development

# Database Configuration (PostgreSQL 16)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=stockpilot
DB_SSLMODE=disable
DB_POOL_MAX_CONNS=25
DB_POOL_MIN_CONNS=5
DB_POOL_MAX_CONN_LIFETIME=1h
DB_POOL_MAX_CONN_IDLE_TIME=30m

# CORS Configuration
ALLOWED_ORIGINS=*

# Authentication Security (JWT & Refresh Sessions)
# IN PRODUCTION: Set JWT_SECRET to a cryptographically secure random string of at least 32 bytes
JWT_SECRET=stockpilot-secure-auth-jwt-secret-key-32-chars-dev
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Development Seed Accounts (Disabled automatically when ENV=production)
DEV_ADMIN_EMAIL=admin@stockpilot.com
DEV_ADMIN_PASSWORD=Admin@123456
DEV_ADMIN_NAME=ผู้ดูแลระบบ StockPilot
DEV_STAFF_EMAIL=staff@stockpilot.com
DEV_STAFF_PASSWORD=Staff@123456
DEV_STAFF_NAME=พนักงาน สต๊อกไพลอต
